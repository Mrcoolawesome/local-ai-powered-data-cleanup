# Secrets — scraper .env files hold live customer platform credentials
*.env
.env
.env.*
!.env.example
session.json

# Real customer data — contains live customer PII (names, emails, phones, addresses)
/example-data/

# Scraper runtime artifacts — not source, and output/ contains real customer data
example-scrapers/**/output/
example-scrapers/**/venv/
example-scrapers/**/node_modules/
example-scrapers/**/__pycache__/
example-scrapers/**/*.pyc
example-scrapers/**/progress.json
example-scrapers/**/jobs_api_cache.json

# App dependencies / build output (populated once scaffolding lands)
node_modules/
.next/
dist/
build/
__pycache__/
*.pyc

# Local file storage for uploads/attachments — never belongs in git
/storage/
/uploads/

# Zoom spike — proprietary SDK download (never redistribute) + regenerable screenshots
spikes/zoom-presentation-bot/zoom-sdk/
spikes/zoom-presentation-bot/output/
spikes/zoom-presentation-bot/zoom-sdk-integration/build/

# Ollama prompting spike — regenerable outputs of an actual model run
spikes/ollama-prompting/raw_response.txt
spikes/ollama-prompting/generated_clean.py
spikes/ollama-prompting/combined_script.py
spikes/ollama-prompting/system_prompt.txt
spikes/ollama-prompting/fixtures/

# Prisma's auto-installed agent-skill reference docs: .claude/skills/ are
# symlinks INTO .agents/skills/ (the real content lives there) — keep both,
# or .claude/skills/ ends up as dangling symlinks for anyone who clones this
# repo. Only .windsurf/skills/ (a redundant symlink shim for a tool not in
# use here) is safe to exclude.
apps/web/.windsurf/

.DS_Store
*.log
