# Copy to .env before running `docker compose up`. Never commit the real
# .env — it holds real secrets (Postgres password, auth secret).

POSTGRES_PASSWORD=change-me

# Generate with: openssl rand -base64 33
AUTH_SECRET=

# Seeds the first admin-provisioned login — see apps/web/prisma/seed.ts.
# Run manually after first `docker compose up`, not automatically on every
# boot (see docs/11-deployment.md): docker compose exec web pnpm prisma db seed
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Default value written into Settings.ollamaBaseUrl on first run only —
# after that, the UI-editable setting takes over (docs/05-llm-prompting.md).
DEFAULT_OLLAMA_BASE_URL=http://devin-server:11434

# devin-server is a Tailscale MagicDNS hostname that containers can't
# reliably resolve by name (docs/11-deployment.md) — find the current IP
# with `tailscale status` or `resolvectl query devin-server` on the host.
DEVIN_SERVER_TAILSCALE_IP=

# web/ai-service run as this uid/gid (not root) so files written into the
# bind-mounted ./storage are owned by you, not root — find yours with
# `id -u` / `id -g`. Defaults to 1000/1000 (the common first-user id) if
# unset.
APP_UID=
APP_GID=

# Absolute host path of this repo's ./storage directory — e.g.
# /home/you/local-ai-powered-data-cleanup/storage. ai-service needs this
# to launch sandbox containers as siblings of itself (Docker-outside-of-
# Docker, docs/11-deployment.md): the Docker daemon resolves bind-mount
# sources against the HOST filesystem, not ai-service's own container
# filesystem, so ai-service can't just hand it "/app/storage" (that path
# only means something inside ai-service's own container).
HOST_STORAGE_PATH=

# GID of the host's `docker` group — ai-service needs to be a member to
# use the mounted Docker socket (owned root:docker, mode 660) without
# running as root itself. Find yours with:
# getent group docker | cut -d: -f3
# Defaults to 987 if unset; override if yours differs.
DOCKER_GID=

# Absolute host path of this repo's ./example-scrapers directory — same
# Docker-outside-of-Docker reason as HOST_STORAGE_PATH above (docs/11-deployment.md).
HOST_SCRAPERS_PATH=
