# Copy to .env (gitignored) in this folder, or export these directly, before
# running zoom_join_and_share. Never commit real values — same rule as every
# other credential in this project (docs/06-security-sandboxing.md).

# From the Zoom Marketplace app's "App Credentials" page, under the
# "Meeting SDK" feature — NOT the OAuth Client ID/Secret from a different
# feature on the same app.
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# A personal meeting ID you control, so joining/leaving repeatedly during
# testing doesn't bother anyone else.
ZOOM_TEST_MEETING_NUMBER=
ZOOM_TEST_MEETING_PASSWORD=

# X11 device-name string for the window to share, per StartAppShare's doc
# comment in meeting_sharing_interface.h:
#   "hostname:display_number-screen_number(x,y,width,height)-app_id"
# Get the real window_id via `xdotool search --name <chromium-window-title>`
# against the same Xvfb display the stage-1 spike (../start-xvfb-chromium.sh)
# already proved works — e.g. ":99-0(0,0,1280,720)-<window_id>".
ZOOM_SHARE_X_WINDOW_HANDLE=
