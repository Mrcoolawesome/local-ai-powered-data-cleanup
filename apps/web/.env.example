# Copy to .env for local (non-Docker) dev. In the Docker Compose stack,
# these are provided by the root .env instead — see ../../docker-compose.yml.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/data_cleanup"

# Generate with: openssl rand -base64 33
AUTH_SECRET=""

# Seeds the first admin-provisioned login (see prisma/seed.ts) — there's no
# public signup flow. Leave unset to skip user creation on seed.
SEED_USER_EMAIL=""
SEED_USER_PASSWORD=""
