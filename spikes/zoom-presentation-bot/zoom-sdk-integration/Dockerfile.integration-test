# Combined stage-1 + stage-2 integration test image: everything needed to
# build zoom_join_and_share fresh AND run Xvfb + Chromium in the same
# container, sharing one X11 display — required for StartAppShare to find
# the browser window. See run-integration-test.sh for the actual test flow.
#
# debian:bookworm-slim, not ubuntu — Ubuntu's `chromium` package is a snap
# stub that doesn't run in a container (no snapd); Debian ships a real
# binary. Confirmed the hard way during development of this spike.
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    chromium \
    x11-utils \
    xdotool \
    imagemagick \
    python3 \
    cmake \
    make \
    g++ \
    qt6-base-dev \
    libssl-dev \
    fonts-liberation \
    procps \
    # Transitive runtime deps of the SDK's bundled Qt6/libmeetingsdk.so,
    # found via `ldd` — not obvious from the SDK's own docs, and the error
    # for a missing one is a plain "cannot open shared object file" with no
    # hint of which package provides it:
    libatomic1 \
    libxcb-cursor0 \
    libxcb-xtest0 \
    libxkbcommon-x11-0 \
    libnss3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work/zoom-sdk-integration
