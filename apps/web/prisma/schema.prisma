// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  targetSchemas        TargetSchema[]
  uploadedFiles        UploadedFile[]
  datasets             Dataset[]
  chatSessions         ChatSession[]
  scraperDefinitions   ScraperDefinition[]
  presentationSessions PresentationSession[]
  auditLogs            AuditLog[]
}

// Singleton row (fixed id) rather than per-user: the Ollama endpoint is one
// physical server shared by every user of this internal tool, not a
// per-user preference — see docs/05-llm-prompting.md.
model Settings {
  id            String   @id @default("singleton")
  ollamaBaseUrl String   @default("http://devin-server:11434")
  ollamaModel   String   @default("gemma4-e4b-262k:latest")
  updatedAt     DateTime @updatedAt
}

// Phase 2 per docs/02-data-model.md. Per-user, not shared — each user's
// target shapes and rules only apply to their own datasets (isolation
// model in docs/00-overview.md).
//
// `columns` shape (validated in TS at the API boundary via
// lib/target-schema.ts, not enforceable in the DB): an array of
//   { name: string, type: string, required: boolean,
//     structurallyOptional: boolean, description: string }
// `required` + `structurallyOptional` are deliberately two separate flags,
// not one tri-state — per docs/10-target-schema-reference.md's Design
// Implication, most "missing" data across every real sheet examined was
// structurally expected (e.g. `unit` empty because most addresses aren't
// multi-unit), not a genuine data-quality gap. Collapsing that into a
// single "optional" flag would make the Phase 3 audit report unable to
// tell "nobody filled this in and that's fine" apart from "this is
// usually there and its absence here is worth a human's attention."
model TargetSchema {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String
  version    Int      @default(1)
  columns    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cleaningRules CleaningRule[]
  datasets      Dataset[]
}

// A single non-negotiable rule (docs/03: "Mobile and Landline columns must
// combine into a single 'Phone' column"). `structured` mirrors the
// {rule, description} shape spikes/ollama-prompting/build_prompt.py already
// proved the LLM follows correctly — kept as loose Json rather than fully
// normalized columns since different rules need different fields (a
// combine-columns rule needs source column names; a normalize rule needs a
// pattern) and forcing one rigid shape now would fight Phase 3's actual
// prompt-builder code before it exists.
model CleaningRule {
  id             String       @id @default(cuid())
  targetSchemaId String
  targetSchema   TargetSchema @relation(fields: [targetSchemaId], references: [id], onDelete: Cascade)
  rule           String
  rawDescription String
  structured     Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum FileSourceType {
  MANUAL_UPLOAD
  SCRAPER
}

enum FileStatus {
  PENDING
  CLEANED
  ERROR
}

// A raw file on disk (docs/03-ingestion-and-scrapers.md). `filePath` is
// relative to the shared /app/storage bind mount (docs/11-deployment.md)
// so both `web` and `ai-service` resolve it the same way.
model UploadedFile {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  filePath         String
  originalFilename String
  sourceType       FileSourceType @default(MANUAL_UPLOAD)
  status           FileStatus     @default(PENDING)
  datasetId        String?
  dataset          Dataset?       @relation(fields: [datasetId], references: [id])
  scraperRunId     String?
  scraperRun       ScraperRun?    @relation(fields: [scraperRunId], references: [id])
  createdAt        DateTime       @default(now())
}

// The logical, cleaned table the chat/audit UI and presentation view point
// at (docs/02-data-model.md) — distinct from the raw UploadedFile(s) it
// was derived from. `filePath`/`rowCount` are null until Phase 3's
// cleaning pipeline actually produces cleaned output.
model Dataset {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  targetSchemaId String
  targetSchema   TargetSchema @relation(fields: [targetSchemaId], references: [id])
  filePath       String?
  rowCount       Int?
  lastCleanedAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  uploadedFiles        UploadedFile[]
  cleaningRuns         CleaningRun[]
  chatSessions         ChatSession[]
  presentationSessions PresentationSession[]
}

enum CleaningRunStatus {
  SUCCESS
  FAILED
}

// One execution of generate-then-sandbox-execute (docs/04-ai-cleaning-and-audit.md).
// `generatedScript` is kept even on failure — a bad generation is a
// debuggable event, not just an opaque error (app/main.py's /clean/execute
// in ai-service returns the code alongside a 422 for exactly this reason).
model CleaningRun {
  id              String            @id @default(cuid())
  datasetId       String
  dataset         Dataset           @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  generatedScript String            @db.Text
  status          CleaningRunStatus
  sandboxLogs     String?           @db.Text
  errorMessage    String?           @db.Text
  startedAt       DateTime          @default(now())
  finishedAt      DateTime?

  auditReport AuditReport?
}

// Rendered from the sandbox's measured output per docs/04's "templated,
// not a second free-form LLM call" — `summary` is the {report, measured}
// JSON ai-service's sandbox.py computed from TargetSchema's
// required/structurallyOptional flags, `contentMarkdown` is that same data
// rendered into what the chat UI actually displays.
model AuditReport {
  id              String      @id @default(cuid())
  cleaningRunId   String      @unique
  cleaningRun     CleaningRun @relation(fields: [cleaningRunId], references: [id], onDelete: Cascade)
  summary         Json
  contentMarkdown String      @db.Text
  createdAt       DateTime    @default(now())
}

// One conversation per Dataset (docs/02-data-model.md) — find-or-create,
// not one-per-message-thread: re-cleans and on-demand audits append to the
// same session rather than starting a new one each time (docs/04's
// "appended to the existing ChatSession rather than starting a new one").
model ChatSession {
  id        String   @id @default(cuid())
  datasetId String
  dataset   Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  messages ChatMessage[]
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

enum ChatMessageType {
  TEXT
  AUDIT_REPORT
  ACTION_CONFIRMATION
}

model ChatMessage {
  id            String          @id @default(cuid())
  chatSessionId String
  chatSession   ChatSession     @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  role          ChatMessageRole
  content       String          @db.Text
  messageType   ChatMessageType @default(TEXT)
  createdAt     DateTime        @default(now())
}

enum ScraperRuntime {
  PYTHON
  NODE
}

// A registered scraper (docs/03-ingestion-and-scrapers.md) — `scriptPath`/
// `readmePath` are relative to the shared scrapers root (docs/11-deployment.md,
// mirrors the storage-root convention), not absolute paths, so both `web`
// and `ai-service` resolve them the same way. `lastValidatedAt` is set by a
// human, not inferred — READMEs drift out of sync with the actual platform
// (the HCP v1→v2 rewrite in example-scrapers/ is exactly this happening for
// real), so "an agent successfully ran this once" is not the same claim as
// "a human confirmed this mapping is still correct."
model ScraperDefinition {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformName    String
  scriptPath      String
  readmePath      String
  runtime         ScraperRuntime
  lastValidatedAt DateTime?
  createdAt       DateTime       @default(now())
  // The most recent successful /scraper/plan result — generated
  // automatically right after registration (so a scraper is immediately
  // runnable, not just registered) and refreshed whenever a human
  // explicitly asks for it. Still just a cache, not a substitute for
  // re-planning: a README can drift out of sync with the actual platform
  // (docs/03-ingestion-and-scrapers.md), so the detail page always offers
  // a way to regenerate it, not only read this stored copy forever.
  cachedPlan      Json?
  planCachedAt    DateTime?

  runs ScraperRun[]
}

enum ScraperRunStatus {
  RUNNING
  // The sandboxed process printed the generic "waiting on stdin" marker
  // (docs/03-ingestion-and-scrapers.md) and is blocked mid-run — e.g. a
  // site's 2FA/verification-code screen a scraper can't get past on its
  // own. pendingPrompt holds the text to show the human; submitting a
  // value relays it into the still-running container's stdin and the run
  // goes back to RUNNING.
  AWAITING_INPUT
  COMPLETED
  INTERRUPTED
  FAILED
}

// One agent-triggered execution (docs/03). `commandExecuted` and
// `planJson` (the LLM's full command plan, including the confidence/
// concerns fields) are kept even on failure — same "a bad generation is a
// debuggable event" principle as CleaningRun.generatedScript.
model ScraperRun {
  id                  String            @id @default(cuid())
  scraperDefinitionId String
  scraperDefinition   ScraperDefinition @relation(fields: [scraperDefinitionId], references: [id], onDelete: Cascade)
  commandExecuted     String
  planJson            Json
  status              ScraperRunStatus  @default(RUNNING)
  logOutput           String?           @db.Text
  filesIngestedCount  Int               @default(0)
  startedAt           DateTime          @default(now())
  finishedAt          DateTime?
  // Set as soon as execution starts, cleared once the run reaches a
  // terminal status. Lets a later poll/input request find the actual
  // still-running Docker container again without keeping any in-memory
  // state in ai-service itself (which would break across restarts/
  // multiple ai-service instances).
  containerId         String?
  // Only non-null while status is AWAITING_INPUT — the prompt text parsed
  // from the scraper's own stdout marker line, shown to the human.
  pendingPrompt       String?           @db.Text

  uploadedFiles        UploadedFile[]
  attachments          Attachment[]
  presentationSessions PresentationSession[]
}

// A file (photo, document) pulled by a scraper and tied to a business
// entity (docs/02-data-model.md). The entity-linking fields are loose and
// nullable on purpose — not every platform's export has the same entity
// graph (a House Call Pro job attachment has a job_number; some platforms
// only ever expose a customer id), so forcing one required shape here
// would fight the very "dynamically adapt to the output structure"
// requirement this whole subsystem exists for.
model Attachment {
  id            String     @id @default(cuid())
  scraperRunId  String
  scraperRun    ScraperRun @relation(fields: [scraperRunId], references: [id], onDelete: Cascade)
  filePath      String
  jobId         String?
  customerId    String?
  invoiceNumber String?
  createdAt     DateTime   @default(now())
}

enum PresentationViewKind {
  DATASET
  ATTACHMENTS
}

enum PresentationSessionStatus {
  IDLE
  JOINING
  SHARING
  ERROR
}

// Tracks what's currently "live" for the Zoom bot + Pi controller
// (docs/07-zoom-bot.md, docs/08-raspberry-pi-controller.md). `/present/[id]`
// renders whatever this points at. Two nullable FKs rather than one
// polymorphic pointer — Prisma has no first-class polymorphic relation, and
// the two "kinds" a session can show (a cleaned Dataset table, or an
// Attachment set) are different enough shapes that a single generic
// "entityId: String" column would need app-code guessing to resolve; a
// discriminated pair the DB can still enforce FK integrity on is worth the
// two extra nullable columns.
//
// v1 simplification: "attachments" mode points at one ScraperRun (shows
// every Attachment from that run) rather than a finer per-job/per-customer
// grouping — matches the same v1 gap noted on Attachment.jobId/customerId
// in docs/03-ingestion-and-scrapers.md (no per-platform path parser yet).
model PresentationSession {
  id                  String                    @id @default(cuid())
  userId              String
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Set per-session through /presentations/[id] (not .env — docs/07-zoom-bot.md:
  // a meeting number/passcode is a per-presentation fact, not a deployment
  // secret like ZOOM_SDK_KEY/ZOOM_SDK_SECRET, which stay in .env since
  // they're the same for every meeting this app ever joins). The Zoom Bot
  // Service fetches both at startup via GET /api/presentations/[id]/zoom-meeting
  // rather than taking them as container env vars.
  zoomMeetingId       String?
  zoomMeetingPassword String?
  status              PresentationSessionStatus @default(IDLE)
  activeViewKind      PresentationViewKind?
  activeDatasetId     String?
  activeDataset       Dataset?                  @relation(fields: [activeDatasetId], references: [id])
  activeScraperRunId  String?
  activeScraperRun    ScraperRun?               @relation(fields: [activeScraperRunId], references: [id])
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([userId])
}

// Append-only compliance/traceability record (docs/02-data-model.md) —
// `entityType`/`entityId` are a loose polymorphic pair (no DB-level FK,
// same tradeoff SQL always has for "one log table, many referenced kinds")
// rather than one column per subsystem, since new subsystems (this phase's
// PresentationSession view switches, per docs/08-raspberry-pi-controller.md)
// shouldn't need a schema migration just to start logging.
//
// Known gap, stated rather than silently absent: only this phase's new
// PresentationSession-related actions write here so far. Retrofitting
// every earlier phase's mutating action (schema edits, cleaning runs,
// scraper runs) to also log here is real follow-up work, not done in this
// pass — scoped out to keep Phase 6 bounded to what it actually needed.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}
